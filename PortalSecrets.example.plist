<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Copy this file to PortalSecrets.plist and paste the value of
	  PORTAL_ADMIN_KEY from the Vercel project settings.

	  This is now only a BOOTSTRAP credential: it authorizes
	  POST /api/business/register, which issues the per-business device token
	  that actually authorizes business data. It no longer grants access to any
	  business's data on its own.

	  PortalSecrets.plist is gitignored. Never commit it.
	-->
	<key>PORTAL_ADMIN_KEY</key>
	<string>replace_with_value_from_vercel</string>
</dict>
</plist>
